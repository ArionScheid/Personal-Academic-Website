---
// Shared wrapper for every page section: anchor id, numbered heading, consistent spacing.
interface Props {
  id: string;
  title: string;
  number?: string;
  wide?: boolean;
}

const { id, title, number, wide = false } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class:list={['container', { 'container--wide': wide }]}>
    <header class="section__header">
      {number && <span class="section__number">{number}</span>}
      <h2 id={`${id}-title`}>{title}</h2>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-line);
  }

  .section__header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .section__number {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-faint);
    font-variant-numeric: tabular-nums;
  }

  h2 {
    font-size: var(--text-xl);
  }
</style>
