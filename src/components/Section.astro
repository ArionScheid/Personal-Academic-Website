---
// Shared wrapper for every page section: anchor id, heading, consistent spacing.
interface Props {
  id: string;
  title: string;
  wide?: boolean;
}

const { id, title, wide = false } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-title`}>
  <div class:list={['container', { 'container--wide': wide }]}>
    <header class="section__header">
      <h2 id={`${id}-title`}>{title}</h2>
    </header>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-line);
  }

  .section__header {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: var(--text-xl);
  }
</style>
