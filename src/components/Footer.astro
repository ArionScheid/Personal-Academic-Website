---
import { profile } from '@/data/profile';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container container--wide footer__inner">
    <p>© {year} {profile.name}</p>
    <div class="footer__center">
      <p>
        Created using <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>
      </p>
      <!-- Offenlegung gemäß § 25 Abs. 5 MedienG: name + place of residence -->
      <p>Medieninhaber: {profile.name}, Wien</p>
    </div>
    <a class="footer__top" href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: 2rem;
    font-size: var(--text-sm);
    color: var(--color-faint);
  }

  /* Three equal outer columns keep the middle block truly centred */
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .footer__center {
    text-align: center;
  }

  .footer__top {
    justify-self: end;
  }

  @media (max-width: 600px) {
    .footer__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .footer__top {
      justify-self: center;
    }
  }

  .footer p {
    margin: 0;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
