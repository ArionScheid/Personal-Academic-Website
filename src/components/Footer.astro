---
import { profile } from '@/data/profile';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container container--wide footer__inner">
    <!-- Offenlegung gemäß § 25 Abs. 5 MedienG: name + place of residence -->
    <p>© {year} {profile.name} · Medieninhaber: {profile.name}, Wien</p>
    <p>
      Created using <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>
    </p>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: 2rem;
    font-size: var(--text-sm);
    color: var(--color-faint);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer p {
    margin: 0;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
